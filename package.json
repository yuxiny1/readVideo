{
  "name": "readvideo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": ".venv/bin/python main.py",
    "start": ".venv/bin/python main.py",
    "build": "npm run build:frontend",
    "build:frontend": "ng build",
    "check": "npm run check:frontend && npm run test:frontend:coverage && npm run test:coverage",
    "check:frontend": "ng build --configuration development",
    "test:frontend": "ng test --watch=false",
    "test:frontend:coverage": "ng test --watch=false --coverage",
    "test": ".venv/bin/python -m unittest -v",
    "test:coverage": ".venv/bin/python -m coverage run -m unittest discover -v && .venv/bin/python -m coverage report --fail-under=80",
    "mlx:chat": "\"$HOME/mlx-env/bin/mlx_lm.chat\" --model \"${READVIDEO_MLX_MODEL:-mlx-community/Qwen2.5-72B-Instruct-3bit}\" --max-tokens 2048",
    "mlx:serve": "\"$HOME/mlx-env/bin/mlx_lm.server\" --model \"${READVIDEO_MLX_MODEL:-mlx-community/Qwen2.5-72B-Instruct-3bit}\" --host 127.0.0.1 --port 8080 --max-tokens 4096 --prompt-cache-size 1 --prefill-step-size 1024",
    "mlx:whisper:install": "\"$HOME/mlx-env/bin/python\" -m pip install -U mlx-whisper",
    "mlx:whisper:download": "\"$HOME/mlx-env/bin/python\" -c \"from huggingface_hub import snapshot_download; snapshot_download('mlx-community/whisper-large-v3-mlx')\"",
    "containers:up": "./scripts/containers.sh up",
    "containers:up:gpu": "./scripts/containers.sh up-gpu",
    "containers:up:host-ollama": "./scripts/containers.sh up-host-ollama",
    "containers:management": "./scripts/containers.sh management",
    "containers:down": "./scripts/containers.sh down",
    "containers:logs": "./scripts/containers.sh logs",
    "containers:ps": "./scripts/containers.sh ps",
    "containers:migrate": "./scripts/containers.sh migrate",
    "containers:pull-model": "./scripts/containers.sh pull-model",
    "containers:backup": "./scripts/containers.sh backup"
  },
  "dependencies": {
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.18",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.30.0"
    }
  }
}

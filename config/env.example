READVIDEO_TRANSCRIPTION_BACKEND=mlx
READVIDEO_DOWNLOAD_DIR=downloads/youtube_videos
READVIDEO_NOTES_DIR=notes
READVIDEO_DATABASE_PATH=readvideo.sqlite3
# Container deployment uses PostgreSQL instead of READVIDEO_DATABASE_PATH.
READVIDEO_DATABASE_URL=
READVIDEO_REDIS_URL=
READVIDEO_TASK_QUEUE=readvideo
READVIDEO_TASK_TTL_SECONDS=2592000

# Apple Silicon MLX Whisper settings. Use the full large-v3 model for maximum local quality.
READVIDEO_MLX_WHISPER_PYTHON=~/mlx-env/bin/python
READVIDEO_MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# whisper.cpp compatibility settings, used by containers and non-Apple systems.
READVIDEO_LOCAL_WHISPER_CLI=whisper-cli
READVIDEO_LOCAL_WHISPER_MODEL=models/ggml-large-v3.bin
READVIDEO_LOCAL_WHISPER_LANGUAGE=auto
READVIDEO_LOCAL_WHISPER_PROMPT=
READVIDEO_LOCAL_WHISPER_AUDIO_FILTER=highpass=f=80,lowpass=f=8000,loudnorm=I=-16:TP=-1.5:LRA=11

# Markdown note settings. Ollama is for detailed paragraph summaries and article-style sections, not audio transcription.
READVIDEO_NOTES_BACKEND=ollama
READVIDEO_NOTE_STYLE=detailed
READVIDEO_OLLAMA_MODEL=qwen3.6:35b
READVIDEO_OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Apple Silicon MLX alternative. Start mlx_lm.server before selecting MLX in the web app.
READVIDEO_MLX_MODEL=mlx-community/Qwen2.5-72B-Instruct-3bit
READVIDEO_MLX_URL=http://127.0.0.1:8080/v1/chat/completions

# Optional OpenAI backend settings
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
READVIDEO_CHUNK_SECONDS=180
